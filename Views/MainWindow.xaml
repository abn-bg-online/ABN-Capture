<Window x:Class="ABNCapture.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ABN Capture"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        ResizeMode="CanMinimize"
        WindowStyle="None"
        AllowsTransparency="True"
        FontFamily="Segoe UI"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>

        <!-- Mode button: icon + label, rounded highlight on hover -->
        <Style x:Key="ModeTile" TargetType="Button">
            <Setter Property="Width" Value="84"/>
            <Setter Property="Height" Value="68"/>
            <Setter Property="Foreground" Value="#A6ADC8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#45475A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Big round record button: white ring + inner disc; turns into a red square while recording -->
        <Style x:Key="RecordRing" TargetType="Button">
            <Setter Property="Width" Value="64"/>
            <Setter Property="Height" Value="64"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse Stroke="White" StrokeThickness="3" Fill="Transparent"/>
                            <Border x:Name="Inner" Margin="7" Background="White" CornerRadius="30"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                         Value="Stop Recording">
                                <Setter TargetName="Inner" Property="Background" Value="#F38BA8"/>
                                <Setter TargetName="Inner" Property="Margin" Value="18"/>
                                <Setter TargetName="Inner" Property="CornerRadius" Value="6"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Inner" Property="Background" Value="#F38BA8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Inner" Property="Margin" Value="10"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Round ghost icon button (settings) -->
        <Style x:Key="RoundGhostButton" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Foreground" Value="#A6ADC8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="21">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#313244"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Round close badge -->
        <Style x:Key="CloseBadge" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#2A2B3A" BorderBrush="#45475A"
                                BorderThickness="1" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F38BA8"/>
                                <Setter Property="Foreground" Value="#1E1E2E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer margin leaves room for the shadow and the floating close badge -->
    <Grid Margin="26">
        <StackPanel>

            <!-- The floating bar -->
            <Border Background="#F01E1E2E" CornerRadius="36" Padding="14,10"
                    BorderBrush="#33FFFFFF" BorderThickness="1" HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.55"/>
                </Border.Effect>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- Selection = Select Area -->
                    <Button x:Name="BtnArea" Style="{StaticResource ModeTile}"
                            Click="BtnArea_Click" ToolTip="Select Area">
                        <StackPanel>
                            <Canvas Width="24" Height="24" HorizontalAlignment="Center">
                                <Rectangle Canvas.Left="3" Canvas.Top="5" Width="18" Height="14"
                                           RadiusX="2" RadiusY="2" StrokeThickness="1.8"
                                           StrokeDashArray="2.2 1.6"
                                           Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Canvas>
                            <TextBlock Text="Selection" FontSize="11" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Screen = Full Screen -->
                    <Button x:Name="BtnFullscreen" Style="{StaticResource ModeTile}"
                            Click="BtnFullscreen_Click" Margin="4,0,0,0" ToolTip="Full Screen">
                        <StackPanel>
                            <Canvas Width="24" Height="24" HorizontalAlignment="Center">
                                <Rectangle Canvas.Left="2" Canvas.Top="3" Width="20" Height="13"
                                           RadiusX="2.5" RadiusY="2.5" StrokeThickness="1.8"
                                           Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <Line X1="8" Y1="20.5" X2="16" Y2="20.5" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <Line X1="12" Y1="16" X2="12" Y2="20" StrokeThickness="1.8"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Canvas>
                            <TextBlock Text="Screen" FontSize="11" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Border Width="1" Background="#33FFFFFF" Margin="14,12"/>

                    <!-- Big round record button -->
                    <Button x:Name="BtnRecord" Content="Start Recording"
                            Style="{StaticResource RecordRing}"
                            Click="BtnRecord_Click" ToolTip="Start / Stop Recording"/>

                    <Border Width="1" Background="#33FFFFFF" Margin="14,12"/>

                    <!-- Settings -->
                    <Button x:Name="BtnSettings" Style="{StaticResource RoundGhostButton}"
                            Click="BtnSettings_Click" ToolTip="Settings">
                        <TextBlock Text="&#9881;" FontSize="19"/>
                    </Button>
                </StackPanel>
            </Border>

            <TextBlock x:Name="TxtHotkeyHint"
                       Text="Ctrl+Shift+S = Select Area   |   Ctrl+Shift+F = Full Screen"
                       FontSize="10" Foreground="#9A9CAB" HorizontalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,14,0,0"/>
        </StackPanel>

        <!-- Close badge floating on the top-right corner of the bar -->
        <Button Click="BtnClose_Click" Style="{StaticResource CloseBadge}"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,-16,-16,0" ToolTip="Close">
            <TextBlock Text="&#10005;" FontSize="12"/>
        </Button>
    </Grid>
</Window>
