<Window x:Class="ABNCapture.SnipOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Background="Black"
        FontFamily="Segoe UI"
        Cursor="Cross"
        KeyDown="Window_KeyDown">

    <Window.Resources>

        <Style x:Key="ModeToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="80"/>
            <Setter Property="Height" Value="66"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A6ADC8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#313244"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#45475A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptureRing" TargetType="Button">
            <Setter Property="Width" Value="64"/>
            <Setter Property="Height" Value="64"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse Stroke="White" StrokeThickness="3" Fill="Transparent"/>
                            <Ellipse x:Name="Inner" Margin="7" Fill="White"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Inner" Property="Fill" Value="#F38BA8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Inner" Property="Margin" Value="10"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundGhostButton" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Foreground" Value="#A6ADC8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="21">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#313244"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseBadge" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#2A2B3A" BorderBrush="#45475A"
                                BorderThickness="1" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F38BA8"/>
                                <Setter Property="Foreground" Value="#1E1E2E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Frozen screenshot of the desktop -->
        <Image x:Name="FrozenImage" Stretch="Fill" IsHitTestVisible="False"/>

        <!-- Dim layer with a hole for the selection -->
        <Path x:Name="DimPath" Fill="#A0000000" IsHitTestVisible="False"/>

        <!-- Selection layer -->
        <Canvas x:Name="Overlay" Background="Transparent"
                MouseLeftButtonDown="Overlay_MouseDown"
                MouseMove="Overlay_MouseMove"
                MouseLeftButtonUp="Overlay_MouseUp">

            <Rectangle x:Name="SelRect" Stroke="White" StrokeThickness="2"
                       Fill="Transparent" Visibility="Collapsed" IsHitTestVisible="False"/>

            <Ellipse x:Name="HandleTL" Width="16" Height="16" Fill="White" Stroke="#66000000"
                     Visibility="Collapsed" IsHitTestVisible="False"/>
            <Ellipse x:Name="HandleTR" Width="16" Height="16" Fill="White" Stroke="#66000000"
                     Visibility="Collapsed" IsHitTestVisible="False"/>
            <Ellipse x:Name="HandleBL" Width="16" Height="16" Fill="White" Stroke="#66000000"
                     Visibility="Collapsed" IsHitTestVisible="False"/>
            <Ellipse x:Name="HandleBR" Width="16" Height="16" Fill="White" Stroke="#66000000"
                     Visibility="Collapsed" IsHitTestVisible="False"/>

            <Border x:Name="SizeBadge" Background="#CC1E1E2E" CornerRadius="10" Padding="10,4"
                    Visibility="Collapsed" IsHitTestVisible="False">
                <TextBlock x:Name="SizeText" Foreground="White" FontSize="12"/>
            </Border>
        </Canvas>

        <!-- Floating bar (positioned bottom-center of the primary screen from code) -->
        <Grid x:Name="Bar" HorizontalAlignment="Left" VerticalAlignment="Top"
              Cursor="Arrow" SizeChanged="Bar_SizeChanged">

            <Border Background="#F01E1E2E" CornerRadius="36" Padding="14,10"
                    BorderBrush="#33FFFFFF" BorderThickness="1" Margin="0,16,16,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.55"/>
                </Border.Effect>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <ToggleButton x:Name="BtnSel" Style="{StaticResource ModeToggle}"
                                  IsChecked="True" Tag="area" Click="Mode_Click" ToolTip="Select Area">
                        <StackPanel>
                            <Canvas Width="24" Height="24" HorizontalAlignment="Center">
                                <Rectangle Canvas.Left="3" Canvas.Top="5" Width="18" Height="14"
                                           RadiusX="2" RadiusY="2" StrokeThickness="1.8"
                                           StrokeDashArray="2.2 1.6"
                                           Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                            </Canvas>
                            <TextBlock Text="Selection" FontSize="11" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <ToggleButton x:Name="BtnScr" Style="{StaticResource ModeToggle}"
                                  Tag="screen" Click="Mode_Click" Margin="4,0,0,0" ToolTip="Full Screen">
                        <StackPanel>
                            <Canvas Width="24" Height="24" HorizontalAlignment="Center">
                                <Rectangle Canvas.Left="2" Canvas.Top="3" Width="20" Height="13"
                                           RadiusX="2.5" RadiusY="2.5" StrokeThickness="1.8"
                                           Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                                <Line X1="8" Y1="20.5" X2="16" Y2="20.5" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                                <Line X1="12" Y1="16" X2="12" Y2="20" StrokeThickness="1.8"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                            </Canvas>
                            <TextBlock Text="Screen" FontSize="11" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <Border Width="1" Background="#33FFFFFF" Margin="14,12"/>

                    <Button x:Name="BtnCapture" Style="{StaticResource CaptureRing}"
                            Click="Capture_Click" ToolTip="Capture (Enter)"/>

                    <Border Width="1" Background="#33FFFFFF" Margin="14,12"/>

                    <Button x:Name="BtnSettings" Style="{StaticResource RoundGhostButton}"
                            Click="Settings_Click" ToolTip="Settings">
                        <TextBlock Text="&#9881;" FontSize="19"/>
                    </Button>
                </StackPanel>
            </Border>

            <Button Style="{StaticResource CloseBadge}" Click="Close_Click"
                    HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="Close (Esc)">
                <TextBlock Text="&#10005;" FontSize="12"/>
            </Button>
        </Grid>
    </Grid>
</Window>
