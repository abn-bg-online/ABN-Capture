<Window x:Class="ABNCapture.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ABN Capture - Settings"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True"
        FontFamily="Segoe UI"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>

        <!-- Rounded text box (folder path + hotkey boxes) -->
        <Style x:Key="RoundedBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#CBA6F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HotkeyBox" TargetType="TextBox" BasedOn="{StaticResource RoundedBox}">
            <Setter Property="Foreground" Value="#CBA6F7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Secondary pill button -->
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#45475A"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="20" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary (accent) pill button -->
        <Style x:Key="AccentPill" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Background" Value="#F38BA8"/>
            <Setter Property="Foreground" Value="#1E1E2E"/>
        </Style>

        <!-- Round close button -->
        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Foreground" Value="#A6ADC8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#26273A" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F38BA8"/>
                                <Setter Property="Foreground" Value="#1E1E2E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle switch instead of a plain checkbox -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            <Border x:Name="Track" Grid.Column="1" Width="44" Height="24"
                                    CornerRadius="12" Background="#45475A" Margin="12,0,0,0">
                                <Ellipse x:Name="Thumb" Width="18" Height="18" Fill="White"
                                         HorizontalAlignment="Left" Margin="3,0"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#F38BA8"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Section card -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#26273A"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A6ADC8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <!-- Outer margin leaves room for the drop shadow -->
    <Grid Margin="18">
        <Border CornerRadius="28" BorderBrush="#33FFFFFF" BorderThickness="1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#F01E1E2E" Offset="0"/>
                    <GradientStop Color="#F0181825" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.55" Color="Black"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="52"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title bar (drag area) -->
                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                        <Ellipse Width="9" Height="9" Fill="#F38BA8" Margin="0,0,9,0"/>
                        <TextBlock Text="Settings" Foreground="White" FontSize="14" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="&#10005;" Style="{StaticResource CloseButton}"
                            HorizontalAlignment="Right" Margin="0,0,14,0"
                            Click="BtnCancel_Click"/>
                </Grid>

                <StackPanel Grid.Row="1" Margin="20,0,20,20">

                    <!-- Saving -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="SAVING" Style="{StaticResource SectionTitle}"/>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtSaveFolder" Grid.Column="0"
                                         Style="{StaticResource RoundedBox}" IsReadOnly="True"/>
                                <Button x:Name="BtnBrowse" Grid.Column="1" Content="Browse" Margin="8,0,0,0"
                                        Style="{StaticResource PillButton}" Click="BtnBrowse_Click"/>
                            </Grid>

                            <CheckBox x:Name="ChkAlwaysSave" Content="Always save screenshots to file"
                                      Style="{StaticResource Switch}"/>
                            <CheckBox x:Name="ChkCopyClipboard" Content="Copy screenshots to clipboard"
                                      Style="{StaticResource Switch}"/>
                            <CheckBox x:Name="ChkStartWithWindows" Content="Start ABN Capture with Windows"
                                      Style="{StaticResource Switch}"/>
                        </StackPanel>
                    </Border>

                    <!-- Capturing -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="CAPTURING" Style="{StaticResource SectionTitle}"/>

                            <CheckBox x:Name="ChkDirectSelection"
                                      Content="Capture directly after selecting (skip the toolbar)"
                                      Style="{StaticResource Switch}"/>

                            <TextBlock Text="When off, the screen freezes and the toolbar appears at the bottom."
                                       FontSize="11" Foreground="#6C7086" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Hotkeys -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="HOTKEYS" Style="{StaticResource SectionTitle}"/>

                            <TextBlock Text="Select Area" Foreground="White" FontSize="13" Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtHotkeyArea" Style="{StaticResource HotkeyBox}"
                                     IsReadOnly="True"
                                     PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                     GotFocus="HotkeyBox_GotFocus"/>

                            <TextBlock Text="Full Screen" Foreground="White" FontSize="13" Margin="0,12,0,6"/>
                            <TextBox x:Name="TxtHotkeyFullscreen" Style="{StaticResource HotkeyBox}"
                                     IsReadOnly="True"
                                     PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                     GotFocus="HotkeyBox_GotFocus"/>

                            <TextBlock Text="Click a hotkey box, then press your desired key combination."
                                       FontSize="11" Foreground="#6C7086" Margin="2,10,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Actions -->
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancel" Style="{StaticResource PillButton}"
                                Click="BtnCancel_Click"/>
                        <Button Grid.Column="2" Content="Save Settings" Style="{StaticResource AccentPill}"
                                Click="BtnSave_Click"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
