<Window x:Class="ABNCapture.CaptureToolbar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>

        <!-- Mode button: icon + label, rounded highlight when active -->
        <Style x:Key="ModeToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="80"/>
            <Setter Property="Height" Value="66"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A6ADC8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#313244"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#45475A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small round icon button (settings) -->
        <Style x:Key="RoundGhostButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A6ADC8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#313244"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Round close badge (top-right of the bar) -->
        <Style x:Key="CloseBadge" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#2A2B3A" BorderBrush="#45475A"
                                BorderThickness="1" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F38BA8"/>
                                <Setter Property="Foreground" Value="#1E1E2E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer margin leaves room for the shadow and the floating close badge -->
    <Grid Margin="26">

        <Border Background="#F01E1E2E" CornerRadius="34" Padding="14,10"
                BorderBrush="#33FFFFFF" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.55"/>
            </Border.Effect>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                <!-- Selection -->
                <ToggleButton x:Name="BtnModeArea" Style="{StaticResource ModeToggle}"
                              IsChecked="True" Click="ModeButton_Click" Tag="area"
                              ToolTip="Select Area">
                    <StackPanel>
                        <Canvas Width="24" Height="24" HorizontalAlignment="Center">
                            <Rectangle Canvas.Left="3" Canvas.Top="5" Width="18" Height="14"
                                       RadiusX="2" RadiusY="2" StrokeThickness="1.8"
                                       StrokeDashArray="2.2 1.6"
                                       Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                        </Canvas>
                        <TextBlock Text="Selection" FontSize="11" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </ToggleButton>

                <!-- Screen -->
                <ToggleButton x:Name="BtnModeScreen" Style="{StaticResource ModeToggle}"
                              Click="ModeButton_Click" Tag="screen" Margin="4,0,0,0"
                              ToolTip="Full Screen">
                    <StackPanel>
                        <Canvas Width="24" Height="24" HorizontalAlignment="Center">
                            <Rectangle Canvas.Left="2" Canvas.Top="3" Width="20" Height="13"
                                       RadiusX="2.5" RadiusY="2.5" StrokeThickness="1.8"
                                       Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                            <Line X1="8" Y1="20.5" X2="16" Y2="20.5" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                            <Line X1="12" Y1="16" X2="12" Y2="20" StrokeThickness="1.8"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                        </Canvas>
                        <TextBlock Text="Screen" FontSize="11" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </ToggleButton>

                <!-- Window -->
                <ToggleButton x:Name="BtnModeWindow" Style="{StaticResource ModeToggle}"
                              Click="ModeButton_Click" Tag="window" Margin="4,0,0,0"
                              ToolTip="Window">
                    <StackPanel>
                        <Canvas Width="24" Height="24" HorizontalAlignment="Center">
                            <Rectangle Canvas.Left="3" Canvas.Top="3" Width="13" Height="10"
                                       RadiusX="2" RadiusY="2" StrokeThickness="1.8"
                                       Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                            <Rectangle Canvas.Left="8" Canvas.Top="9" Width="13" Height="11"
                                       RadiusX="2" RadiusY="2" StrokeThickness="1.8"
                                       Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                        </Canvas>
                        <TextBlock Text="Window" FontSize="11" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </ToggleButton>

                <Border Width="1" Background="#33FFFFFF" Margin="14,12"/>

                <!-- Big round capture button: ring + inner disc -->
                <Button x:Name="BtnCapture" Click="Capture_Click" Margin="2,0"
                        Width="60" Height="60" Cursor="Hand" ToolTip="Capture"
                        FocusVisualStyle="{x:Null}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Ellipse Stroke="White" StrokeThickness="3" Fill="Transparent"/>
                                <Ellipse x:Name="Inner" Margin="7" Fill="White"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Inner" Property="Fill" Value="#F38BA8"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Inner" Property="Margin" Value="10"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Border Width="1" Background="#33FFFFFF" Margin="14,12"/>

                <!-- Settings -->
                <Button x:Name="BtnSettingsQuick" Click="Settings_Click"
                        Style="{StaticResource RoundGhostButton}" ToolTip="Settings">
                    <TextBlock Text="&#9881;" FontSize="18"/>
                </Button>
            </StackPanel>
        </Border>

        <!-- Close badge floating on the top-right corner -->
        <Button x:Name="BtnClose" Click="Close_Click" Style="{StaticResource CloseBadge}"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,-16,-16,0" ToolTip="Close">
            <TextBlock Text="&#10005;" FontSize="12"/>
        </Button>
    </Grid>
</Window>
