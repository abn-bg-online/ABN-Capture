<Application x:Class="ABNCapture.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf">
    <Application.Resources>
        <tb:TaskbarIcon x:Key="TrayIcon"
                         ToolTipText="ABN Capture"
                         MenuActivation="LeftOrRightClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Select Area" Click="TrayArea_Click"/>
                    <MenuItem Header="Full Screen" Click="TrayFullscreen_Click"/>
                    <Separator/>
                    <MenuItem Header="Settings" Click="TraySettings_Click"/>
                    <MenuItem Header="Exit" Click="TrayExit_Click"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Application.Resources>
</Application>
